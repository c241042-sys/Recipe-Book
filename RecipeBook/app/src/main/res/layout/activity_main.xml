<?xml version="1.0" encoding="utf-8"?>

<androidx.coordinatorlayout.widget.CoordinatorLayout
    xmlns:android="http://schemas.android.com/apk/res/android"
    xmlns:app="http://schemas.android.com/apk/res-auto"
    android:layout_width="match_parent"
    android:layout_height="match_parent"
    android:background="#FAF9F6">

    <LinearLayout
        android:id="@+id/linearLayout"
        android:layout_width="match_parent"
        android:layout_height="match_parent"
        android:orientation="vertical">

        <!-- ヘッダー -->
        <LinearLayout
            android:layout_width="match_parent"
            android:layout_height="60dp"
            android:gravity="center_vertical"
            android:paddingStart="20dp"
            android:paddingEnd="10dp"
            android:background="#FFFFFF">

            <TextView
                android:id="@+id/titleText"
                android:layout_width="0dp"
                android:layout_height="wrap_content"
                android:layout_weight="1"
                android:text="Recipe Book"
                android:textSize="22sp"
                android:textStyle="bold"
                android:textColor="#222222" />

            <TextView
                android:id="@+id/ingredientManageButton"
                android:layout_width="60dp"
                android:layout_height="match_parent"
                android:gravity="center"
                android:text="材料"
                android:textSize="14sp"
                android:textColor="#F28C28" />

            <TextView
                android:id="@+id/tagManageButton"
                android:layout_width="60dp"
                android:layout_height="match_parent"
                android:gravity="center"
                android:text="タグ"
                android:textColor="#F28C28"
                android:textSize="14sp" />

            <TextView
                android:id="@+id/historyButton"
                android:layout_width="60dp"
                android:layout_height="match_parent"
                android:gravity="center"
                android:text="履歴"
                android:textSize="14sp"
                android:textColor="#F28C28" />

            <TextView
                android:id="@+id/favoriteManageButton"
                android:layout_width="90dp"
                android:layout_height="match_parent"
                android:gravity="center"
                android:text="お気に入り"
                android:textSize="12sp"
                android:textColor="#E74C3C" />

        </LinearLayout>

        <!-- 検索欄 -->
        <EditText
            android:id="@+id/searchEditText"
            android:layout_width="match_parent"
            android:layout_height="50dp"
            android:layout_marginStart="16dp"
            android:layout_marginTop="10dp"
            android:layout_marginEnd="16dp"
            android:background="@drawable/search_background"
            android:hint="🔍 レシピ名・タグで検索"
            android:paddingStart="15dp"
            android:paddingEnd="15dp"
            android:singleLine="true"
            android:textSize="14sp" />

        <!-- レシピ一覧 -->
        <androidx.recyclerview.widget.RecyclerView
            android:id="@+id/recipeRecyclerView"
            android:layout_width="match_parent"
            android:layout_height="0dp"
            android:layout_marginTop="10dp"
            android:layout_weight="1"
            android:clipToPadding="false"
            android:paddingStart="10dp"
            android:paddingEnd="10dp" />

    </LinearLayout>

    <!-- レシピ追加ボタン -->
    <com.google.android.material.floatingactionbutton.FloatingActionButton
        android:id="@+id/addButton"
        android:layout_width="wrap_content"
        android:layout_height="wrap_content"
        android:layout_margin="20dp"
        android:contentDescription="レシピを追加"
        android:src="@android:drawable/ic_input_add"
        app:backgroundTint="#F28C28"
        app:layout_anchor="@+id/linearLayout"
        app:layout_anchorGravity="end|bottom"
        app:tint="#FFFFFF" />

</androidx.coordinatorlayout.widget.CoordinatorLayout>