<?xml version="1.0" encoding="utf-8"?>

<ScrollView
    xmlns:android="http://schemas.android.com/apk/res/android"
    android:layout_width="match_parent"
    android:layout_height="match_parent"
    android:background="#FAF9F6">

    <LinearLayout
        android:layout_width="match_parent"
        android:layout_height="wrap_content"
        android:orientation="vertical"
        android:padding="20dp">

        <!-- ヘッダー -->
        <LinearLayout
            android:layout_width="match_parent"
            android:layout_height="60dp"
            android:gravity="center_vertical"
            android:background="#FFFFFF">

            <TextView
                android:id="@+id/backButton"
                android:layout_width="50dp"
                android:layout_height="match_parent"
                android:gravity="center"
                android:text="‹"
                android:textSize="35sp"
                android:textColor="#333333" />

            <TextView
                android:layout_width="match_parent"
                android:layout_height="wrap_content"
                android:text="手順追加"
                android:textSize="20sp"
                android:textStyle="bold"
                android:textColor="#222222" />

        </LinearLayout>


        <!-- 手順番号 -->
        <TextView
            android:id="@+id/stepNumberText"
            android:layout_width="match_parent"
            android:layout_height="wrap_content"
            android:layout_marginTop="10dp"
            android:text="手順1"
            android:textSize="22sp"
            android:textStyle="bold"
            android:textColor="#F28C28" />


        <!-- タイトル -->
        <TextView
            android:layout_width="match_parent"
            android:layout_height="wrap_content"
            android:layout_marginTop="20dp"
            android:text="タイトル"
            android:textStyle="bold"
            android:textColor="#333333" />

        <EditText
            android:id="@+id/titleEditText"
            android:layout_width="match_parent"
            android:layout_height="55dp"
            android:hint="例：野菜を切る"
            android:singleLine="true"
            android:padding="12dp" />


        <!-- 説明 -->
        <TextView
            android:layout_width="match_parent"
            android:layout_height="wrap_content"
            android:layout_marginTop="15dp"
            android:text="調理手順"
            android:textStyle="bold"
            android:textColor="#333333" />


        <!-- 画像 -->
        <EditText
            android:id="@+id/descriptionEditText"
            android:layout_width="match_parent"
            android:layout_height="140dp"
            android:gravity="top"
            android:hint="調理方法を入力してください"
            android:inputType="textMultiLine"
            android:padding="12dp" />

        <TextView
            android:layout_width="match_parent"
            android:layout_height="wrap_content"
            android:layout_marginTop="15dp"
            android:text="手順画像"
            android:textStyle="bold"
            android:textColor="#333333" />

        <ImageView
            android:id="@+id/stepImage"
            android:layout_width="match_parent"
            android:layout_height="200dp"
            android:layout_marginTop="8dp"
            android:background="#EEEEEE"
            android:scaleType="centerCrop"
            android:src="@drawable/recipe_placeholder"
            android:contentDescription="手順画像" />

        <Button
            android:id="@+id/selectImageButton"
            android:layout_width="match_parent"
            android:layout_height="50dp"
            android:layout_marginTop="8dp"
            android:text="画像を選択" />


        <!-- タイマー -->
        <TextView
            android:layout_width="match_parent"
            android:layout_height="wrap_content"
            android:layout_marginTop="15dp"
            android:text="タイマー"
            android:textStyle="bold"
            android:textColor="#333333" />

        <Spinner
            android:id="@+id/timerSpinner"
            android:layout_width="match_parent"
            android:layout_height="55dp" />


        <!-- 保存 -->
        <Button
            android:id="@+id/saveStepButton"
            android:layout_width="match_parent"
            android:layout_height="55dp"
            android:layout_marginTop="25dp"
            android:text="保存" />

    </LinearLayout>

</ScrollView>